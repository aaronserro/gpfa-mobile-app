# Point the app at a backend. Leave unset (or delete this file's copy) and the
# app runs on the local fixtures in src/data/fixtures.ts.
#
# Expo inlines EXPO_PUBLIC_* at build time — restart `npx expo start` after
# changing it. The value must be reachable FROM THE PHONE: `localhost` is the
# device itself, so use your machine's LAN address in development.
#
# EXPO_PUBLIC_API_URL=https://api.example.org
# EXPO_PUBLIC_API_URL=http://10.0.0.98:3000
