# Point the app at a backend. Leave unset (or delete this file's copy) and the
# app runs on the local fixtures in src/data/fixtures.ts.
#
# Expo inlines EXPO_PUBLIC_* at build time — restart `npx expo start` after
# changing it. The value must be reachable FROM THE PHONE: `localhost` is the
# device itself, so use your machine's LAN address in development.
#
# EXPO_PUBLIC_API_URL=https://api.example.org
# EXPO_PUBLIC_API_URL=http://10.0.0.98:3000

# Web app origin used by the sign-in endpoint for token/cookie handoff logic
# on the backend. For a physical device, localhost means the phone itself, so
# use your Mac's LAN IP instead.
# EXPO_PUBLIC_GPFA_WEB_ORIGIN=http://localhost:3000
# EXPO_PUBLIC_GPFA_WEB_ORIGIN=http://192.168.1.25:3000

# Supabase Auth is called directly to rotate tokens and revoke this device's
# refresh session. Use the same project URL and public publishable key as the
# GPFA web app. Never place a secret or service-role key in an EXPO_PUBLIC var.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Use real remote auth while keeping portal screens on local fixture data. This
# is useful while only auth endpoints are migrated.
# EXPO_PUBLIC_FIXTURE_PORTAL_DATA=true
